# Copia este archivo como ".env" (en la carpeta BACKEND) y completa los valores.
# El archivo ".env" NO se sube a Git: contiene claves.

# --- Obligatoria: clave larga y aleatoria ---
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# --- Base de datos MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=siger_app
DB_PASSWORD=cambia_esta_clave
DB_NAME=siger_db
# Alternativa: una sola URL (si la defines, reemplaza las DB_* de arriba)
# DATABASE_URL=mysql+pymysql://usuario:clave@host:3306/siger_db

# --- Sesion / tokens (opcionales) ---
# JWT_SECRET_KEY=otra_clave_distinta
# JWT_EXPIRES_HOURS=2

# --- Direccion del frontend (CORS y enlace del correo de recuperacion) ---
FRONTEND_URL=http://127.0.0.1:5001

# --- Correo con Gmail (opcional). Sin esto, el enlace de recuperacion se imprime en la consola del backend ---
# MAIL_USER=tucorreo@gmail.com
# MAIL_PASSWORD=contrasena_de_aplicacion_de_google_sin_espacios
# MAIL_NOMBRE=SIGER
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# --- Solo desarrollo ---
# FLASK_DEBUG=1
